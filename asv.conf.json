{
    "version": 1,
    "project": "rgmin",
    "project_url": "https://github.com/OmniPotentRPC/rgmin",
    "repo": ".",
    "branches": ["develop"],
    "show_commit_url": "https://github.com/OmniPotentRPC/rgmin/commit/",
    "environment_type": "virtualenv",
    "pythons": ["3.12"],
    "launch_method": "spawn",
    "install_timeout": 3600,
    "default_benchmark_timeout": 600,
    "benchmark_dir": "benchmarks",
    "results_dir": ".asv/results",
    "html_dir": ".asv/html",
    "matrix": {
        "req": {
            "numpy": ["2.5.4"],
            "asv_bench_memray": ["0.1.2"],
            "memray": ["1.20.0"]
        }
    },
    "build_command": [
        "python -m pip install asv-runner==0.3.2 meson==1.12.1 ninja==1.13.2",
        "python {conf_dir}/benchflow/build_library.py {build_dir}"
    ],
    "install_command": [],
    "uninstall_command": []
}
